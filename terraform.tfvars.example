aws_profile    = "xtremax"
aws_region     = "ap-southeast-2"
aws_account_id = "123456789012" # Replace with your own AWS account ID.

vpc_cidr           = "10.20.0.0/16"
single_nat_gateway = false # One NAT per AZ; true trades resilience for lab cost.

db_engine_version            = "8.4.11"
db_instance_class            = "db.t4g.micro"
db_multi_az                  = true
db_deletion_protection       = true
db_final_snapshot_identifier = "xtremax-wordpress-final-001"

wordpress_ami_id           = "ami-062900c135ab91582" # ap-southeast-2 only; verify before use.
wordpress_instance_type    = "t3.small"
wordpress_desired_capacity = 2
site_url                   = "https://school.example.com" # PLAN-ONLY placeholder; not a real endpoint.
site_admin_email           = "admin@example.com" # Replace before deployment.

origin_domain_name = "origin.example.com" # PLAN-ONLY: replace with an owned origin name.
hosted_zone_id     = null # Existing PUBLIC Route 53 zone ID, or null for external DNS.
